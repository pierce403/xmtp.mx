{
  "name": "xmtp-mx-frontend",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "xmtp.mx",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}

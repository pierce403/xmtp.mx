{
  "name": "xmtp-webmail-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "preview": "npm run build && npm run start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "cloudflare:dry-run:staging": "npx --yes wrangler@4.126.0 deploy --dry-run --config wrangler.jsonc",
    "cloudflare:dry-run:production-candidate": "npx --yes wrangler@4.126.0 versions upload --dry-run --config wrangler.production-preview.jsonc",
    "cloudflare:dry-run:production": "npx --yes wrangler@4.126.0 deploy --dry-run --config wrangler.production.jsonc",
    "cloudflare:deploy:staging": "npx --yes wrangler@4.126.0 deploy --config wrangler.jsonc",
    "cloudflare:bootstrap:production": "npx --yes wrangler@4.126.0 deploy --config wrangler.production-preview.jsonc",
    "cloudflare:upload:production": "npx --yes wrangler@4.126.0 versions upload --config wrangler.production-preview.jsonc",
    "cloudflare:cutover:production": "npx --yes wrangler@4.126.0 triggers deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@wagmi/connectors": "^5.9.9",
    "@wagmi/core": "^2.20.3",
    "@xmtp/browser-sdk": "^5.3.0",
    "@xmtp/content-type-reaction": "1.1.12",
    "@xmtp/content-type-remote-attachment": "1.1.12",
    "@xmtp/content-type-reply": "1.1.12",
    "@xmtp/user-preferences-bindings-wasm": "0.3.6",
    "@xmtp/xmtp-js": "12.1.0",
    "copy-webpack-plugin": "13.0.1",
    "crypto-browserify": "3.12.1",
    "ethers": "6.16.0",
    "next": "15.4.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stream-browserify": "3.0.0",
    "viem": "2.43.2",
    "wagmi": "^2.16.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.3",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.2",
    "eslint-config-next": "15.0.7",
    "file-loader": "^6.2.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "wasm-loader": "^1.3.0"
  },
  "overrides": {
    "viem": "2.43.2",
    "@babel/helpers": "7.28.4",
    "minimatch@3.1.2": {
      "brace-expansion": "1.1.12"
    }
  }
